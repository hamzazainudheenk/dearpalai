# ==================================
# DearPal WhatsApp Service Configuration
# ==================================

# Server
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API
META_ACCESS_TOKEN=your_meta_access_token_here
VERIFY_TOKEN=your_webhook_verify_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_API_VERSION=v23.0

# AI Services
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

# Embedding & Vector DB (Phase 2 — not used yet)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_PROVIDER=pinecone
VECTOR_DB_URL=your_vector_db_url_here
VECTOR_DB_API_KEY=your_vector_db_api_key_here

# RAG Configuration (Phase 2 — not used yet)
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_RESULTS=5

# Risk Assessment (Phase 2 — not used yet)
RISK_THRESHOLD=0.8

# Logging
LOG_LEVEL=info

# Server-side secrets for caretaker codes/OTPs at rest —
# set real random values in production (e.g. `openssl rand -hex 32`).
CARETAKER_CODE_PEPPER=set_a_long_random_secret_here
CARETAKER_CODE_ENCRYPTION_KEY=set_a_32_byte_hex_encryption_key_here
OTP_PEPPER=set_a_different_long_random_secret_here

# Caretaker OTP delivery. No SMS provider is configured in this project —
# leave unset/`none` to have OTP send fail with a clear "not configured"
# error. Set to `mock` for local development ONLY (refused if
# NODE_ENV=production) — see src/services/otp/otp-provider.ts.
OTP_PROVIDER=none
